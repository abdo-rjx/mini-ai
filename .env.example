# Unified AI Agent - Environment Configuration
# =============================================
# Copy this file to .env and fill in your API keys

# =============================================
# REQUIRED: At least one API key must be set
# =============================================

# Google Gemini API Key
# Get yours at: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Anthropic Claude API Key
# Get yours at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your_anthropic_key_here

# =============================================
# OPTIONAL: Custom Configuration
# =============================================

# Path to PDF documents folder
# BOOKS_PATH=./books

# Path to vector database storage
# VECTOR_DB_PATH=./vector_db

# Logging level (DEBUG, INFO, WARNING, ERROR)
# LOG_LEVEL=INFO

# Default AI provider (gemini or claude)
# DEFAULT_PROVIDER=gemini

# =============================================
# OPTIONAL: Model Selection
# =============================================

# Gemini model to use
# GEMINI_MODEL=gemini-2.5-flash

# Claude model to use
# CLAUDE_MODEL=claude-sonnet-4-6

# =============================================
# OPTIONAL: RAG Configuration
# =============================================

# Embedding model for vector search
# EMBEDDING_MODEL=all-MiniLM-L6-v2

# Number of document chunks to retrieve
# SEARCH_K=4

# Chunk size for document splitting
# CHUNK_SIZE=700

# Chunk overlap for document splitting
# CHUNK_OVERLAP=100
